        <enumeratedValueSet variable="trust-based-switch-chance">
          <value value="10"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="trust-flip">
          <value value="5"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="random-seed" first="0" step="1" last="49"></steppedValueSet>
