  <experiments>
    <experiment name="init-trust" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="true">
      <setup>setup</setup>
      <go>go</go>
      <postExperiment>experiment-done-sound</postExperiment>
      <metrics>
        <metric>count houses with [ count my-formal-connections = 1 ]</metric>
        <metric>count houses with [ count my-informal-sds = 1 ]</metric>
        <metric>count houses with [ count my-in-informal-hookons = 1 ]</metric>
        <metric>count houses with [ count my-links = 0 ]</metric>
        <metric>count houses with [ trust-kplc = true and trust-ipd = true ]</metric>
        <metric>count houses with [ trust-kplc = true and trust-ipd = false ]</metric>
        <metric>count houses with [ trust-kplc = false and trust-ipd = true ]</metric>
        <metric>count houses with [ trust-kplc = false and trust-ipd = false ]</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="cost-based-switch-chance">
          <value value="20"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="debt-threshold">
          <value value="10"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="elec-price">
          <value value="28"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="elec-price-lifeline">
          <value value="23"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="enforcement-freq">
          <value value="52"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="enforcement-number">
          <value value="5"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="formal-connect-fee">
          <value value="625"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="informal-connection-capacity">
          <value value="13"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="init-trust-ipd" first="0" step="20" last="100"></steppedValueSet>
        <steppedValueSet variable="init-trust-kplc" first="0" step="20" last="100"></steppedValueSet>
        <enumeratedValueSet variable="initial-formal-pct">
          <value value="50"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="likely-switch-chance">
          <value value="50"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="max-informal-fee">
          <value value="500"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="min-demand">
          <value value="2"></value>
